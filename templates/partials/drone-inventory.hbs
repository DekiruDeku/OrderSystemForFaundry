<div class="inventory-capacity inventory-capacity--drone">
  <div class="inventory-gacs">
    <label>ГАЦы:</label>
    <input name="data.gacs" type="text" value="{{@root.data.gacs}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
  </div>

  <div class="inventory-gacs">
    <label>Грузоподъёмность:</label>
    <input name="data.carryingCapacity" type="text" value="{{@root.data.carryingCapacity}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
  </div>

  <div class="inventory-gacs">
    <label>Ячейки инвентаря:</label>
    <input name="data.inventorySlots" type="text" value="{{@root.data.inventorySlots}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
  </div>

  <div class="inventory-gacs">
    <label>Ячейки быстрого доступа:</label>
    <input name="data.quickAccessSlots" type="text" value="{{@root.data.quickAccessSlots}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
  </div>

  <p>Текущая загрузка: {{@root.data.inventoryCount}} / {{@root.data.carryingCapacity}}</p>
  <p>Ячейки инвентаря: {{carrySlotsUsed}} / {{@root.data.inventorySlots}}</p>
  <p>Ячейки быстрого доступа: {{quickAccessSlotsUsed}} / {{@root.data.quickAccessSlots}}</p>
  <p>Всего занято ячеек: {{@root.data.inventoryCount}} / {{totalSlotCapacity}}</p>
  {{#if @root.data.inventoryOver}}
    <p class="inventory-warning">Инвентарь переполнен!</p>
  {{/if}}
</div>

<h3>Используется</h3>
<div class="inventory-grid used-grid">
  {{#each usedGrid as |slot i|}}
    {{> "systems/Order/templates/partials/inventory-slot.hbs" item=slot.item slotType=slot.slotType used=true empty=slot.empty}}
  {{/each}}
</div>

<h3>Ячейки инвентаря</h3>
<div class="inventory-grid">
  {{#each carryGrid as |slot i|}}
    {{> "systems/Order/templates/partials/inventory-slot.hbs" item=slot.item slotType=slot.slotType empty=slot.empty}}
  {{/each}}
</div>

<h3>Ячейки быстрого доступа</h3>
<div class="inventory-grid">
  {{#each quickAccessGrid as |slot i|}}
    {{> "systems/Order/templates/partials/inventory-slot.hbs" item=slot.item slotType=slot.slotType empty=slot.empty}}
  {{/each}}
</div>

<h3>Переполнение</h3>
<div class="inventory-grid">
  {{#each overflowGrid as |slot i|}}
    {{> "systems/Order/templates/partials/inventory-slot.hbs" item=slot.item slotType=slot.slotType empty=slot.empty}}
  {{/each}}
</div>

<h3>Хранилище</h3>
<div class="inventory-grid storage-grid">
  {{#each storageGrid as |slot i|}}
    {{> "systems/Order/templates/partials/inventory-slot.hbs" item=slot.item slotType=slot.slotType empty=slot.empty}}
  {{/each}}
</div>
