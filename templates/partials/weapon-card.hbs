<article class="weapon-card os-equipment-card item {{#if system.inHand}}is-equipped{{/if}}" data-item-id="{{_id}}">
  <div class="os-equipment-card-accent" aria-hidden="true"></div>

  <div class="os-equipment-card-top">
    <div class="os-equipment-media-column">
      <a class="item-edit os-equipment-image-link" data-type="item" title="Открыть {{name}}">
        <img class="os-eq-item-img" src="{{img}}" alt="{{name}}" draggable="true" />
      </a>

      <div class="os-equipment-metrics os-equipment-metrics--under-image">
        {{#if (shouldDisplayField system.displayFields "Damage")}}
          <div class="os-equipment-metric">
            <i class="fas fa-burst"></i>
            <span>Урон</span>
            <strong>{{system.Damage}}</strong>
          </div>
        {{/if}}
        {{#if (shouldDisplayField system.displayFields "Durability")}}
          <div class="os-equipment-metric">
            <i class="fas fa-shield-alt fa-shield-halved"></i>
            <span>Прочность</span>
            <strong>{{system.Durability}}</strong>
          </div>
        {{/if}}
        {{#if (shouldDisplayField system.displayFields "EffectThreshold")}}
          <div class="os-equipment-metric">
            <i class="fas fa-bullseye"></i>
            <span>Порог</span>
            <strong>{{system.EffectThreshold}}</strong>
          </div>
        {{/if}}
      </div>
    </div>

    <div class="os-equipment-card-main">
      <div class="os-equipment-header-row">
        <button type="button" class="equipment-state-toggle os-equipment-state {{#if system.inHand}}is-active{{/if}}" data-equipment-kind="weapon" title="Взять в руку / убрать из руки">
          <span class="os-equipment-state-dot"></span>
          <span>{{#if system.inHand}}Экипировано{{else}}Не экипировано{{/if}}</span>
        </button>

        <div class="os-equipment-card-actions">
          {{#if (eq type "rangeweapon")}}
            <a class="fas fa-dice-d20 roll-ranged-attack" data-item-id="{{_id}}" title="Бросок атаки (дальний бой)"></a>
          {{else}}
            <a class="fas fa-dice-d20 roll-attack" data-item-id="{{_id}}" title="Бросок атаки"></a>
          {{/if}}
          {{#if @root.osCanEdit}}
            <button type="button" class="item-delete" title="Удалить">
              <i class="fas fa-trash"></i>
            </button>
          {{/if}}
        </div>
      </div>

      <a class="item-edit os-equipment-name {{#if system.inHand}}is-active{{/if}}" data-type="item" title="Открыть {{name}}">{{name}}</a>

      {{#if (gt (length system.tags) 0)}}
        <div class="os-eq-tags">
          {{#each system.tags as |tag|}}
            <span class="order-tag-pill order-tag-pill--readonly"
                  data-tooltip="{{#if (orderTagDescription tag)}}{{orderTagDescription tag}}{{else}}Нет описания{{/if}}"
                  data-tooltip-direction="UP">
              {{orderTagLabel tag}}
            </span>
          {{/each}}
        </div>
      {{/if}}
    </div>
  </div>

  {{#if (eq type "rangeweapon")}}
    <div class="os-equipment-secondary-metrics">
      {{#if (shouldDisplayField system.displayFields "Rateoffire")}}<span><b>Скорострельность:</b> {{system.Rateoffire}}</span>{{/if}}
      {{#if (shouldDisplayField system.displayFields "Magazine")}}<span><b>Магазин:</b> {{system.Magazine}}</span>{{/if}}
      {{#if (shouldDisplayField system.displayFields "MagazineSize")}}<span><b>Размер магазина:</b> {{system.MagazineSize}}</span>{{/if}}
      {{#if (shouldDisplayField system.displayFields "Effectivefiringrange")}}<span><b>Эфф. дальность:</b> {{system.Effectivefiringrange}}</span>{{/if}}
      {{#if (shouldDisplayField system.displayFields "Maximumfiringrange")}}<span><b>Макс. дальность:</b> {{system.Maximumfiringrange}}</span>{{/if}}
    </div>
  {{/if}}

  {{#if (shouldDisplayField system.displayFields "OnHitEffects")}}
    <div class="os-equipment-effects">
      <span class="os-equipment-effects-label">Эффекты при попадании</span>
      <span class="os-equipment-effects-value">
        {{#if system.OnHitEffects.length}}
          {{formatWeaponOnHitEffects system.OnHitEffects}}
        {{else}}
          Нет
        {{/if}}
      </span>
    </div>
  {{/if}}
</article>
