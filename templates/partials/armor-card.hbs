<article class="armor-card os-equipment-card item {{#if system.isEquiped}}is-equipped{{/if}}" data-item-id="{{_id}}">
  <div class="os-equipment-card-accent" aria-hidden="true"></div>

  <div class="os-equipment-card-top">
    <div class="os-equipment-media-column">
      <a class="item-edit os-equipment-image-link" data-type="item" title="Открыть {{name}}">
        <img class="os-eq-item-img" src="{{img}}" alt="{{name}}" draggable="true" />
      </a>

      <div class="os-equipment-metrics os-equipment-metrics--under-image os-equipment-metrics--armor-under-image">
        {{#if (shouldDisplayField system.displayFields "Defense")}}
          <div class="os-equipment-metric">
            <i class="fas fa-shield"></i>
            <span>Защита</span>
            <strong>{{#if system.Deffensepotential}}{{system.Deffensepotential}}{{else}}{{system.Defense}}{{/if}}</strong>
          </div>
        {{/if}}
        {{#if (shouldDisplayField system.displayFields "Durability")}}
          <div class="os-equipment-metric">
            <i class="fas fa-shield-alt fa-shield-halved"></i>
            <span>Прочность</span>
            <strong>{{system.Durability}}</strong>
          </div>
        {{/if}}
      </div>
    </div>

    <div class="os-equipment-card-main">
      <div class="os-equipment-header-row">
        <button type="button" class="equipment-state-toggle os-equipment-state {{#if system.isEquiped}}is-active{{/if}}" data-equipment-kind="armor" title="Надеть / снять">
          <span class="os-equipment-state-dot"></span>
          <span>{{#if system.isEquiped}}Экипировано{{else}}Не экипировано{{/if}}</span>
        </button>

        <div class="os-equipment-card-actions">
          {{#if @root.osCanEdit}}
            <button type="button" class="item-delete" title="Удалить">
              <i class="fas fa-trash"></i>
            </button>
          {{/if}}
        </div>
      </div>

      <a class="item-edit os-equipment-name {{#if system.isEquiped}}is-active{{/if}}" data-type="item" title="Открыть {{name}}">{{name}}</a>
    </div>
  </div>
</article>
