{{!-- Один шаблон на три листа: игрок, NPC и Дрон. Отличия развилками по actor.type:
     у Дрона свои ресурсы и свой инвентарь, у NPC переключатель скрытия показателей,
     мастер создания и повышение ранга есть только у игрока. --}}
<form class="{{cssClass}} order-sheet" autocomplete="off">
  <div class="os-sheet">

    <!-- Фон: диагональ, эмблема Ордена, зерно -->
    <div class="osj-bg" aria-hidden="true">
      <div class="osj-drift"></div>
      <div class="osj-slab osj-slab--royal"></div>
      <div class="osj-slab osj-slab--ice"></div>
      <div class="osj-emblem"></div>
      <div class="osj-grain"></div>
    </div>

    <!-- ЛЕВО: меню разделов + содержимое раздела -->
    <aside class="os-left">
      <div class="os-panel os-panel-left os-side-menu">
        <nav class="tabs_side-menu os-tabs os-left-tabs">
          <a class="navbar" data-tab="biography" data-word="Биография" data-caption="Личное дело бойца" data-hint="ЛКМ: открыть раздел «Биография»">Биография</a>
          <a class="navbar" data-tab="inventory" data-word="Инвентарь" data-caption="Груз, ячейки, хранилище" data-hint="ЛКМ: открыть раздел «Инвентарь»">Инвентарь</a>
          <a class="navbar" data-tab="equipment" data-word="Снаряжение" data-caption="Оружие и броня" data-hint="ЛКМ: открыть раздел «Снаряжение»">Снаряжение</a>
          <a class="navbar" data-tab="skills" data-word="Способности" data-caption="Навыки, заклинания, перки" data-hint="ЛКМ: открыть раздел «Способности»">Способности</a>
          <div class="osj-nav-caption"></div>
          <div class="osj-nav-unit" aria-hidden="true">
            <span class="osj-barcode"></span>
            <span>ОПБСАН / 2041</span>
          </div>
        </nav>

        <div class="tab-content os-left-content">
          <div class="osj-giant" aria-hidden="true"></div>
          <div id="biography" class="tab-bar os-left-tab">
            {{> "systems/Order/templates/partials/biography.hbs"}}
          </div>
          <div id="inventory" class="tab-bar os-left-tab">
            {{#if (eq actor.type "Drone")}}
            {{> "systems/Order/templates/partials/drone-inventory.hbs"}}
            {{else}}
            {{> "systems/Order/templates/partials/inventory.hbs"}}
            {{/if}}
          </div>
          <div id="equipment" class="tab-bar os-left-tab">
            {{> "systems/Order/templates/partials/equipment.hbs"}}
          </div>
          <div id="skills" class="tab-bar os-left-tab">
            {{> "systems/Order/templates/partials/skills.hbs"}}
          </div>
        </div>
      </div>
    </aside>

    <!-- ЦЕНТР: портрет, ранг, имя, раса/класс/скорость, ресурсы, эффекты -->
    <main class="os-center">
      <div class="os-panel os-portrait" data-hint="ЛКМ по портрету: сменить картинку">
        <div class="osj-portrait-back" aria-hidden="true"></div>
        <div class="osj-portrait-frame">
          <img class="os-portrait-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
        </div>

        <!-- Ранг: штамп -->
        <div class="os-meta-panel os-meta-panel-rank osj-rank" data-hint="Ранг бойца · Стрелка: повышение ранга">
          <label class="os-meta-label os-rank-label" for="rank"
            data-tooltip="{{rankLimiterTooltip data.Rank}}" data-tooltip-direction="UP">Ранг</label>
          <input class="os-meta-input" id="rank" name="data.Rank" type="text" value="{{data.Rank}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}}
            data-tooltip="{{rankLimiterTooltip data.Rank}}" data-tooltip-direction="UP" />
          {{#if (eq actor.type "Player")}}
          {{#if owner}}
          <button type="button" class="os-rank-up-btn" data-action="rank-up" title="Поднять ранг" data-hint="ЛКМ: поднять ранг">
            <i class="fas fa-arrow-up"></i>
          </button>
          {{/if}}
          {{/if}}
        </div>
      </div>

      <section class="os-top">
        <div class="os-namebar os-namebar-centered">
          {{#if data.bio.rankTitle}}<span class="osj-role">{{data.bio.rankTitle}}</span>{{/if}}
          <textarea class="os-name os-name-compact os-name-multiline" name="name" rows="1" placeholder="Имя персонажа" data-hint="Имя бойца · меняется в режиме Edit" {{#unless osCanEdit}}readonly{{/unless}}>{{actor.name}}</textarea>
        </div>
        {{#if osCanEdit}}
        {{#if (eq actor.type "Player")}}
        {{#unless osCharacterCreationWizardUsed}}
        <button type="button" class="os-btn os-btn-accent os-btn-sm osj-wizard-btn" data-action="open-character-creation-wizard" title="Помощь в создании персонажа" data-hint="ЛКМ: мастер создания персонажа">
          <i class="fas fa-hat-wizard"></i>
          Помощь в создании
        </button>
        {{/unless}}
        {{/if}}
        {{#if (eq actor.type "NPC")}}
        <label class="os-hide-roll-toggle" data-hint="Скрывать бонусы NPC в сообщениях о бросках">
          <input type="checkbox" data-action="toggle-hide-roll-bonuses" {{#if osHideRollBonuses}}checked{{/if}} />
          <span>Скрывать показатели при броске</span>
        </label>
        {{/if}}
        {{/if}}

        <!-- Раса / Класс / Скорость -->
        <div class="os-mid-right">
          <div class="osj-tag osj-tag--race os-meta-half-race" data-hint="Название: открыть расу · Перетащите расу на лист, чтобы сменить">
            <small class="os-meta-half-title">Раса</small>
            <section class="RaceSection">{{#each Races as |race|}}{{> "systems/Order/templates/partials/class-card.hbs" race}}{{/each}}</section>
          </div>
          <div class="osj-tag osj-tag--class os-meta-half-class" data-hint="Название: открыть класс · Перетащите класс на лист, чтобы сменить">
            <small class="os-meta-half-title">Класс</small>
            <section class="ClassSection">{{#each Classes as |class|}}{{> "systems/Order/templates/partials/class-card.hbs" class}}{{/each}}</section>
          </div>
          <div class="osj-tag osj-tag--speed os-meta-panel-speed" data-hint="Скорость · наведите на бонус, чтобы увидеть источники">
            <small class="os-meta-label">Скорость</small>
            <div class="os-resource-move os-resource-values-inline">
              <input name="data.Movement.value" type="text" value="{{data.Movement.value}}" data-dtype="Number" {{#if (eq actor.type "Player")}}readonly{{else}}{{#unless osCanEdit}}readonly{{/unless}}{{/if}} />
              <div class="modifiers-wrapper">
                <span class="modifiers-total">{{sumModifiers data.Movement.modifiers}}</span>
                <div class="modifiers-tooltip">
                  {{#if (gt (length data.Movement.modifiers) 0)}}
                  <ul>
                    {{#each data.Movement.modifiers}}
                    <li><strong>{{this.effectName}}</strong>: {{this.value}}{{#if this.source}} ({{this.source}}) {{/if}}</li>
                    {{/each}}
                  </ul>
                  {{else}}
                  <p>Нет модификаторов</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Ресурсы: заполнение полос (--pct) и пороговые классы ставит OrderSheetFx -->
      <div class="os-mid-left">
        {{#if (eq actor.type "Drone")}}
        {{!-- Дрон: здоровье и три запаса. Всё меняется только в режиме Edit. --}}
        <div class="os-resource os-resource-hp" data-hint="Здоровье дрона · меняется в режиме Edit">
          <span class="os-resource-label">Здоровье</span>
          <div class="os-resource-values">
            <input name="data.Health.value" type="text" value="{{data.Health.value}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
            <span class="os-split">/</span>
            <input name="data.Health.max" type="text" value="{{data.Health.max}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
          <span class="osj-res-flag">Критическое</span>
        </div>
        <div class="os-resource os-resource-plain" data-res="threshold" style="--res: var(--os-cyan)" data-hint="Порог прочности · меняется в режиме Edit">
          <span class="os-resource-label">Порог прочности</span>
          <div class="os-resource-values">
            <input name="data.DurabilityThreshold.value" type="text" value="{{data.DurabilityThreshold.value}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
            <span class="os-split">/</span>
            <input name="data.DurabilityThreshold.max" type="text" value="{{data.DurabilityThreshold.max}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
        </div>
        <div class="os-resource os-resource-plain" data-res="reserve" style="--res: var(--os-stress)" data-hint="Запас прочности · меняется в режиме Edit">
          <span class="os-resource-label">Запас прочности</span>
          <div class="os-resource-values">
            <input name="data.DurabilityReserve.value" type="text" value="{{data.DurabilityReserve.value}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
            <span class="os-split">/</span>
            <input name="data.DurabilityReserve.max" type="text" value="{{data.DurabilityReserve.max}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
        </div>
        <div class="os-resource os-resource-plain" data-res="modules" style="--res: var(--os-mana)" data-hint="Базовый запас опциональных модулей · меняется в режиме Edit">
          <span class="os-resource-label">Опц. модули</span>
          <div class="os-resource-values">
            <input name="data.OptionalModules.value" type="text" value="{{data.OptionalModules.value}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
            <span class="os-split">/</span>
            <input name="data.OptionalModules.max" type="text" value="{{data.OptionalModules.max}}" data-dtype="Number" {{#unless osCanEdit}}readonly{{/unless}} />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
        </div>
        {{else}}
        <div class="os-resource os-resource-hp" data-hint="Здоровье · введите новое значение, чтобы получить урон или лечение">
          <span class="os-resource-label">Здоровье</span>
          <div class="os-resource-values">
            <input name="data.Health.value" type="text" value="{{data.Health.value}}" data-dtype="Number" />
            <span class="os-split">/</span>
            <input name="data.Health.max" type="text" value="{{data.Health.max}}" data-dtype="Number" {{#if (eq actor.type "Player")}}readonly{{/if}} />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
          <span class="osj-res-flag">Критическое</span>
        </div>

        <div class="os-resource os-resource-mana" data-hint="Магическая усталость · копится от заклинаний">
          <span class="os-resource-label">Маг. усталость</span>
          <div class="os-resource-values">
            <input name="data.ManaFatigue.value" type="text" value="{{data.ManaFatigue.value}}" data-dtype="Number" />
            <span class="os-split">/</span>
            <input name="data.ManaFatigue.max" type="text" value="{{data.ManaFatigue.max}}" data-dtype="Number" {{#if (eq actor.type "Player")}}readonly{{/if}} />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
          <span class="osj-res-flag">Предел</span>
        </div>

        <div class="os-resource os-resource-stress" data-hint="Стресс">
          <span class="os-resource-label">Стресс</span>
          <div class="os-resource-values">
            <input name="data.Stress.value" type="text" value="{{data.Stress.value}}" data-dtype="Number" />
            <span class="os-split">/</span>
            <input name="data.Stress.max" type="text" value="{{data.Stress.max}}" data-dtype="Number" readonly />
          </div>
          <div class="os-bar"><div class="os-bar-fill"></div></div>
          <span class="osj-res-flag">Срыв близко</span>
        </div>
        {{/if}}
      </div>

      <!-- Активные эффекты -->
      <section class="os-bottom">
        <div class="os-panel os-effects">
          <div class="os-effects-header">
            <div class="os-effects-title">Активные эффекты</div>
            <button class="apply-debuff os-btn os-btn-accent os-btn-sm" type="button" data-hint="ЛКМ: наложить дебафф">+ Дебафф</button>
          </div>

          <div class="active-effects os-effects-list">
            <ul>
              {{#each effects}}
              <li class="effect-item" data-effect-id="{{this._id}}" data-hint="{{this.name}}{{#if this.description}}: {{this.description}}{{/if}}">
                <div class="effect-icon">
                  <img src="{{this.icon}}" alt="{{this.name}}" title="{{this.name}}" width="32" height="32">
                </div>

                <div class="effect-details">
                  <strong>{{this.name}}</strong>
                  <p title="{{this.description}}">{{this.description}}</p>

                  {{#if this.showLevelControls}}
                  <div class="effect-level-controls">
                    <button class="effect-level-decrease os-btn os-btn-ghost" type="button" aria-label="Понизить уровень дебаффа" data-hint="ЛКМ: понизить стадию">-</button>
                    <span class="effect-level-display">{{this.flags.Order.stateKey}}</span>
                    <button class="effect-level-increase os-btn os-btn-ghost" type="button" aria-label="Повысить уровень дебаффа" data-hint="ЛКМ: повысить стадию">+</button>
                  </div>
                  {{/if}}

                  <button class="remove-effect os-btn os-btn-ghost" type="button" data-effect-id="{{this._id}}" data-hint="ЛКМ: снять эффект">Удалить</button>
                </div>
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </section>
    </main>

    <!-- ПРАВО: характеристики -->
    <aside class="os-right">
      <div class="os-panel os-panel-right">
        <div class="osj-stats-head">Характеристики</div>
        {{> "systems/Order/templates/partials/character-stat-block.hbs"}}
      </div>
    </aside>

    <!-- Низ: строка-хинт и ГАЦ (редактируется во вкладке «Инвентарь») -->
    <footer class="osj-hintbar">
      <div class="osj-hint" aria-live="polite" data-default="Наведите на элемент, и здесь появятся его действия"></div>
      <div class="osj-gacs" data-hint="ГАЦ: валюта Ордена · меняется во вкладке «Инвентарь»">
        <span>ГАЦ</span>
        <b>{{data.gacs}}</b>
      </div>
    </footer>
  </div>

  <script src="systems/Order/scripts/debuff-script.js"></script>
</form>
