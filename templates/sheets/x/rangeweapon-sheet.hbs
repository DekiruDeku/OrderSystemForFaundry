{{!-- Лист предмета «Арсенал» (JRPG). Собрано из templates/sheets/rangeweapon-sheet.hbs: исходные блоки перенесены дословно. --}}
<form class="{{cssClass}} weapon os-item-form osi-form {{#unless osCanEdit}}os-edit-locked{{/unless}}" autocomplete="off">
  <header class="sheet-header os-item-header osi-head">
    <div class="osi-art">
      <div class="osi-art-frame"><img class="os-item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" /></div>
      <svg class="osi-art-crack" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M60 0L53 21L64 33L46 51L56 66L41 100"/><path d="M53 21L33 29M46 51L72 59M56 66L27 80"/></svg>
      <i class="osi-art-corner"></i><i class="osi-art-tick"></i>
      {{#if osCanEdit}}<a class="osi-art-edit" role="button" tabindex="0" aria-label="Сменить изображение" title="Сменить изображение"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-image"/></svg></a>{{/if}}
    </div>
    <div class="osi-headmeta">
      <h1 class="os-item-title">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{ localize 'Name' }}" aria-label="Название предмета" style="--name-size:{{osi.nameSize}}px" />
      </h1>
      <div class="osi-subline">
        <span class="osi-typeplate"><svg class="sig" viewBox="0 0 200 200" aria-hidden="true"><use href="#osi-sig-{{osi.sigil}}"/></svg>{{osi.plate}}</span>
        {{#if osi.sub}}<span class="osi-typeplate-sub">{{osi.sub}}</span>{{/if}}
        <span class="osi-broken-tag"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-alert"/></svg>Сломано</span>
      </div>
      <table class="osi-stats"><tbody>
        <tr class="osi-stat" data-stat="Damage" style="--i:0">
          <th><label class="field-label {{#if (shouldDisplayField data.displayFields 'Damage')}}selected{{/if}}" data-field="Damage">Урон</label></th>
          <td><div class="osi-stat-val"><input name="data.Damage" type="text" value="{{data.Damage}}" data-type="Number" readonly /></div></td>
        </tr>
        <tr class="osi-stat{{#if osi.isBroken}} is-danger{{/if}}" data-stat="Durability" style="--i:1">
          <th><label class="field-label {{#if (shouldDisplayField data.displayFields 'Durability')}}selected{{/if}}" data-field="Durability">Прочность</label></th>
          <td><div class="osi-stat-val"><input name="data.Durability" type="text" value="{{data.Durability}}" data-type="Number" /></div></td>
        </tr>
        <tr class="osi-stat" data-stat="EffectThreshold" style="--i:2">
          <th><label class="field-label {{#if (shouldDisplayField data.displayFields 'EffectThreshold')}}selected{{/if}}" data-field="EffectThreshold" title="Срабатывает при превышении порога. Пусто = 0.">Порог эффекта</label></th>
          <td><div class="osi-stat-val"><input name="data.EffectThreshold" type="text" value="{{data.EffectThreshold}}" data-type="Number" /></div></td>
        </tr>
      </tbody></table>
    </div>
    <div class="osi-headside">
      <div class="osi-toggles">
        <label class="osi-toggle" data-hint="hand">
          <input type="checkbox" name="data.inHand" {{#if data.inHand}}checked{{/if}} class="in-hand-checkbox" />
          <span class="osi-toggle-face"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-hand"/></svg>В руке<span class="osi-toggle-state">{{#if data.inHand}}ДА{{else}}НЕТ{{/if}}</span></span>
        </label>
      </div>
      <div class="osi-mag{{#if osi.mag.empty}} is-empty{{/if}}">
        <div class="osi-mag-top">
          <label class="field-label {{#if (shouldDisplayField data.displayFields 'Magazine')}}selected{{/if}}" data-field="Magazine">Магазин</label>
          <div class="osi-mag-count"><input name="data.Magazine" type="text" value="{{data.Magazine}}" data-type="Number" aria-label="Магазин" /><span>/ {{data.MagazineSize}}</span></div>
        </div>
        <div class="osi-pips" aria-hidden="true">{{#each osi.mag.pips as |c|}}<i class="{{c}}" data-pip="{{@index}}"></i>{{/each}}</div>
        <span class="osi-empty-tag"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-alert"/></svg>Пусто</span>
        <button type="button" class="reload-rangeweapon osi-act{{#if osi.mag.empty}} is-urgent{{/if}}" data-hint="reload"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-reload"/></svg>Перезарядить{{#if osi.mag.steps.length}}<span class="osi-act-steps" aria-label="Прогресс перезарядки {{osi.mag.prog}} из {{osi.mag.heavy}}">{{#each osi.mag.steps as |c|}}<i class="{{c}}"></i>{{/each}}</span>{{/if}}</button>
      </div>
    </div>
  </header>

  <nav class="osi-tabs-wrap">
    <div class="osi-tabs" role="tablist" aria-label="Разделы предмета">
      {{#each osi.tabs as |t|}}<a class="osi-tab{{#if t.active}} active{{/if}}{{#if t.alarm}} is-alarm{{/if}}" data-tab="{{t.id}}" role="tab" aria-selected="{{#if t.active}}true{{else}}false{{/if}}" tabindex="{{#if t.active}}0{{else}}-1{{/if}}" style="--i:{{@index}}">{{t.label}}{{#if t.hasBadge}}<b>{{t.badge}}</b>{{/if}}</a>{{/each}}
      <i class="osi-tab-cursor" aria-hidden="true"></i>
    </div>
  </nav>

  <div class="os-item-body osi-body">
    <div class="osi-pane{{#if (eq osi.tab "main")}} active{{/if}}" data-pane="main" role="tabpanel">
      <div class="osi-grid2">
        <div>
        <section class="osi-sec" style="--i:0">
          <div class="osi-h3"><span>Описание</span></div>
          <textarea name="data.description" class="os-textarea osi-desc">{{data.description}}</textarea>
        </section>
        </div>
        <div>
        <section class="osi-sec" style="--i:1">
          <div class="osi-h3"><span>Основные параметры</span></div>
                    <div class="os-field">
                      <label class="field-label {{#if (shouldDisplayField data.displayFields 'DamageFormula')}}selected{{/if}}" data-field="DamageFormula">Формула урона</label>
                      <input name="data.DamageFormula" type="text" value="{{data.DamageFormula}}" placeholder="например: 5 + Strength * 2" />
                    </div>
          <p class="osi-help">Урон в шапке считается по этой формуле автоматически.</p>
        </section>
        <section class="osi-sec" style="--i:2">
          <div class="osi-h3"><span>Слоты снаряжения</span></div>
                  <select id="weapon-type" name="data.weaponType" class="weapon-type" data-type="String">
          <option value="Основное оружие" {{isSelected data.weaponType "Основное оружие"}}>Основное оружие</option>
          <option value="Вторичное оружие" {{isSelected data.weaponType "Вторичное оружие"}}>Вторичное оружие</option>
          {{#if (isWeaponSlot data.weaponType "melee")}}
            <option value="Холодное оружие" selected disabled>Холодное оружие (недоступно для дальнего)</option>
          {{/if}}
                  </select>
        </section>
        <section class="osi-sec" style="--i:3">
          <div class="osi-h3"><span>Огонь</span></div>
          <div class="osi-fields">
                    <div class="os-field">
                        <label class="field-label {{#if (shouldDisplayField data.displayFields 'Rateoffire')}}selected{{/if}}" data-field="Rateoffire">Скорострельность</label>            <input name="data.Rateoffire" type="text" value="{{data.Rateoffire}}" data-type="Number" />
                    </div>
                      <div class="os-field">
                        <label class="field-label {{#if (shouldDisplayField data.displayFields 'MagazineSize')}}selected{{/if}}" data-field="MagazineSize">Размер магазина</label>
                        <input name="data.MagazineSize" type="text" value="{{data.MagazineSize}}" data-type="Number" />
                      </div>
                    <div class="os-field">
                        <label class="field-label {{#if (shouldDisplayField data.displayFields 'Effectivefiringrange')}}selected{{/if}}" data-field="Effectivefiringrange">Эффективная дальность</label>            <input name="data.Effectivefiringrange" type="text" value="{{data.Effectivefiringrange}}" data-type="Number" />
                    </div>
                    <div class="os-field">
                        <label class="field-label {{#if (shouldDisplayField data.displayFields 'Maximumfiringrange')}}selected{{/if}}" data-field="Maximumfiringrange">Макс. дальность</label>            <input name="data.Maximumfiringrange" type="text" value="{{data.Maximumfiringrange}}" data-type="Number" />
                    </div>
          </div>
        </section>
        </div>
      </div>
    </div>
    <div class="osi-pane{{#if (eq osi.tab "params")}} active{{/if}}" data-pane="params" role="tabpanel">
      <section class="osi-sec advantage-field" style="--i:0">
        <div class="osi-h3"><span>Параметры</span><b>{{data.additionalAdvantages.length}}</b><span class="osi-h3-act">{{#if osCanEdit}}<button type="button" class="modify-advantage-button os-small-btn is-add osi-edit-reveal"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-plus"/></svg>Параметр</button>{{/if}}</span></div>
        <div class="additional-advantages os-pill-list">
          {{#each data.additionalAdvantages as |curAd index| }}
            <div class="advantage-char os-pill" data-index="{{index}}">
              <span class="os-pill-text">{{localize curAd.Characteristic}} {{curAd.Value}}</span>
              {{#if @root.osCanEdit}}<a type="button" class="advantage-remove-characteristic os-pill-action" role="button" tabindex="0" aria-label="Удалить"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-x"/></svg></a>{{/if}}
            </div>
          {{/each}}
          {{#unless data.additionalAdvantages.length}}
            <div class="os-empty">Нет параметров</div>
          {{/unless}}
        </div>
      </section>
      <section class="osi-sec requires-field" style="--i:1">
        <div class="osi-h3"><span>Требования</span><b>{{data.RequiresArray.length}}</b><span class="osi-h3-act">{{#if osCanEdit}}<button type="button" class="modify-require-button os-small-btn is-add osi-edit-reveal"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-plus"/></svg>Требование</button>{{/if}}</span></div>
        {{#if osi.unmet}}<div class="osi-warn osi-warn-req"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-alert"/></svg><span>{{osi.actorName}} не проходит требования: <b>{{osi.unmet}}</b></span></div>{{/if}}
                <div class="requires-array os-pill-list">
                  {{#each data.RequiresArray as |curRq index| }}
                    <div class="requires-char os-pill {{lookup @root.osi.reqCls index}}" data-index="{{index}}">
                      <span class="osi-req-mark" aria-hidden="true"><svg class="ic osi-req-ok" aria-hidden="true" focusable="false"><use href="#osi-i-check"/></svg><svg class="ic osi-req-no" aria-hidden="true" focusable="false"><use href="#osi-i-x"/></svg></span>
                      <span class="os-pill-text">{{formatRequirement curRq}}</span>
                      {{#if @root.osCanEdit}}<a type="button" class="requires-remove-characteristic os-pill-action" role="button" tabindex="0" aria-label="Удалить"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-x"/></svg></a>{{/if}}
                    </div>
                  {{/each}}
                  {{#unless data.RequiresArray.length}}
                    <div class="os-empty">Нет требований</div>
                  {{/unless}}
                </div>
      </section>
      <section class="osi-sec" style="--i:2">
        <div class="osi-h3"><span>Характеристики атаки</span><b>{{data.AttackCharacteristics.length}}</b><span class="osi-h3-act">{{#if osCanEdit}}<button type="button" class="open-attack-dialog os-small-btn osi-edit-reveal"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-gear"/></svg>Настроить</button>{{/if}}</span></div>
        <div class="attack-characteristics-array os-pill-list">
          {{#each data.AttackCharacteristics as |char index| }}
            <div class="attack-char os-pill" data-index="{{index}}">
              <span class="os-pill-text">{{localize char}}</span>
              {{#if @root.osCanEdit}}<a type="button" class="remove-attack-characteristic os-pill-action" role="button" tabindex="0" aria-label="Удалить"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-x"/></svg></a>{{/if}}
            </div>
          {{/each}}
          {{#unless data.AttackCharacteristics.length}}
            <div class="os-empty">Не выбрано</div>
          {{/unless}}
        </div>
      </section>
    </div>
    <div class="osi-pane{{#if (eq osi.tab "mods")}} active{{/if}}" data-pane="mods" role="tabpanel">
      <section class="osi-sec" style="--i:0">
        <div class="osi-h3"><span>Модификации</span><b>{{modificationCount}}/{{modificationSlots}}</b></div>
        <div class="osi-slots">
          <div class="osi-slots-bar" aria-hidden="true">{{#each osi.slots.cells as |c|}}<i class="{{c}}" data-slot="{{@index}}"></i>{{/each}}</div>
          <div class="osi-slots-num{{#if modificationHasOverflow}} is-over{{/if}}" title="Занято слотов: {{modificationCount}} / {{modificationSlots}}">{{modificationCount}}<small> / {{modificationSlots}}</small></div>
          <div class="os-field">
            <label>Слоты модификации</label>
            <input name="data.Modificationslots" type="text" value="{{data.Modificationslots}}" data-type="Number" />
          </div>
        </div>
        {{#if modificationHasOverflow}}<div class="osi-warn osi-warn-over"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-alert"/></svg><span>Лимит превышен на <b>{{modificationOverflow}}</b>: модов <b>{{modificationCount}}</b>, слотов <b>{{modificationSlots}}</b></span></div>{{/if}}
        {{#if osCanEdit}}
        <div class="drop-area modifications-drop-area" data-hint="drop">
  <svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-tray"/></svg>
          <p class="os-help">Перетащите сюда предмет типа "Regular Item"</p>
        </div>
        {{/if}}
                <div class="modifications-list os-list">
                  {{#each modifications as |mod|}}
                    <div class="modification-row os-row" data-modification-id="{{mod.id}}">
                      <div class="modification-main">
                        <img class="modification-img" src="{{mod.img}}" alt="{{mod.name}}" />
                        <a class="modification-open" data-modification-id="{{mod.id}}">{{mod.name}}</a>
                        {{#if mod.missing}}
                          <span class="modification-missing">(недоступно)</span>
                        {{/if}}
                      </div>
                      {{#if @root.osCanEdit}}<button type="button" class="modification-remove os-small-btn is-danger" data-modification-id="{{mod.id}}"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-trash"/></svg>Удалить</button>{{/if}}
                    </div>
                  {{/each}}
                  {{#unless modifications.length}}
                    <div class="os-empty">Нет модификаций</div>
                  {{/unless}}
                </div>
      </section>
    </div>
    <div class="osi-pane{{#if (eq osi.tab "effects")}} active{{/if}}" data-pane="effects" role="tabpanel">
      <section class="osi-sec weapon-effects" style="--i:0">
        <div class="osi-h3"><h3 class="os-panel-title field-label {{#if (shouldDisplayField data.displayFields 'OnHitEffects')}}selected{{/if}}" data-field="OnHitEffects">Эффекты при попадании</h3><b>{{data.OnHitEffects.length}}</b><span class="osi-h3-act">{{#if osCanEdit}}<button type="button" class="add-weapon-effect os-small-btn is-add osi-edit-reveal"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-plus"/></svg>Эффект</button>{{/if}}</span></div>
                <div class="weapon-effects-list os-list">
                  {{#each data.OnHitEffects as |effect index| }}
                    <div class="weapon-effect-row os-row" data-index="{{index}}" style="gap:8px; align-items:center;">
                      <select name="data.OnHitEffects.{{index}}.debuffKey" class="os-select" style="flex:1; min-width:180px;">
                        <option value="">— выберите дебафф —</option>
                        {{#each ../debuffOptions as |opt|}}
                          <option value="{{opt.key}}" {{isSelected opt.key effect.debuffKey}}>{{opt.label}}</option>
                        {{/each}}
                      </select>

                      <select name="data.OnHitEffects.{{index}}.stateKey" class="os-select" style="width:88px; {{#unless effect.debuffHasLevels}}display:none;{{/unless}}">
                        <option value="1" {{isSelected effect.stateKey "1"}}>1</option>
                        <option value="2" {{isSelected effect.stateKey "2"}}>2</option>
                        <option value="3" {{isSelected effect.stateKey "3"}}>3</option>
                      </select>

                      {{#if @root.osCanEdit}}<button type="button" class="remove-weapon-effect os-small-btn is-danger" data-index="{{index}}"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-trash"/></svg>Удалить</button>{{/if}}
                    </div>
                  {{/each}}
                  {{#unless data.OnHitEffects.length}}
                    <div class="os-empty">Нет эффектов</div>
                  {{/unless}}
                </div>
        <p class="osi-help">Срабатывают, когда бросок атаки проходит порог эффекта из шапки.</p>
      </section>
      {{#if hasMassAttackTag}}
      <section class="osi-sec" style="--i:1">
        <div class="osi-h3"><span>Массовая атака (шаблон)</span></div>
                <div class="os-form-grid">
                  <div class="os-field">
                    <label>Форма</label>
                    <select name="data.AoEShape" data-type="String">
                      {{#each weaponAoeShapeTypes as |opt|}}
                        <option value="{{opt.value}}" {{isSelected ../data.AoEShape opt.value}}>{{opt.label}}</option>
                      {{/each}}
                    </select>
                  </div>

                  <div class="os-field">
                    <label>Размер</label>
                    <input name="data.AoESize" type="text" value="{{data.AoESize}}" data-type="Number" />
                    <div class="os-help">0 = нет массовой атаки</div>
                  </div>

                  <div class="os-field">
                    <label>Ширина</label>
                    <input name="data.AoEWidth" type="text" value="{{data.AoEWidth}}" data-type="Number" />
                    <div class="os-help">Для линии/прямоугольника</div>
                  </div>

                  <div class="os-field">
                    <label>Угол</label>
                    <input name="data.AoEAngle" type="text" value="{{data.AoEAngle}}" data-type="Number" />
                    <div class="os-help">Для конуса</div>
                  </div>

                  <div class="os-field">
                    <label>Цвет</label>
                    <input name="data.AoEColor" type="text" value="{{data.AoEColor}}" data-type="String" placeholder="#ffffff (пусто = цвет игрока)" />
                  </div>
                </div>
        <p class="osi-help">Поля видны, потому что у оружия есть тег «Массовая атака».</p>
      </section>
      {{/if}}
    </div>
    <div class="osi-pane{{#if (eq osi.tab "tags")}} active{{/if}}" data-pane="tags" role="tabpanel">
      <section class="osi-sec" style="--i:0">
        <div class="osi-h3"><span>Теги оружия</span><b>{{data.tags.length}}</b></div>
              <div class="order-tags">
                {{#if osCanEdit}}
                  <div class="os-tag-row osi-edit-reveal">
                    <input class="order-tag-input" type="text" placeholder="добавить тег..." />
                    <button type="button" class="tag-add os-small-btn is-add" aria-label="Добавить тег" title="Добавить тег"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-plus"/></svg></button>
                    <select class="order-tag-select">
                      <option value="">- выберите тег -</option>
                      {{#each weaponTagOptions as |tagOpt|}}
                        <option value="{{tagOpt.key}}">{{tagOpt.label}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="tag-add-select os-small-btn is-add" aria-label="Добавить тег из списка" title="Добавить тег из списка"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-plus"/></svg></button>
                  </div>
                {{/if}}

                  <div class="order-tag-list">
                  {{#each data.tags as |tag index|}}
                    <span class="order-tag-pill"
                    data-tooltip="{{#if (orderTagDescription tag)}}{{orderTagDescription tag}}{{else}}Нет описания{{/if}}"
                    data-tooltip-direction="UP">
                  {{orderTagLabel tag}}
                  {{#if @root.osCanEdit}}<a type="button" class="tag-remove" data-index="{{index}}" data-tag="{{tag}}" role="button" tabindex="0" aria-label="Убрать тег"><svg class="ic" aria-hidden="true" focusable="false"><use href="#osi-i-x"/></svg></a>{{/if}}
                  </span>
                  {{/each}}

                {{#unless data.tags.length}}
                <div class="os-empty">Нет тегов</div>
                {{/unless}}
          </div>
        </div>
      </section>
    </div>
    <div class="osi-wipe" aria-hidden="true"><i></i><i></i></div>
  </div>

  <footer class="osi-hint" aria-live="off">
    <div class="osi-hint-text"></div>
    <span class="osi-hint-code">{{#if osi.actorName}}Боец: {{osi.actorName}}{{/if}}</span>
  </footer>
</form>
